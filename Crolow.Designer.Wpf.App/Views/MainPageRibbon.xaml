<UserControl x:Class="Crolow.Designer.Wpf.App.Views.MainPageRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/runtime"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:Fluent="urn:fluent-ribbon">
    <Grid>
        <Fluent:Ribbon>

            <!-- HOME -->
            <Fluent:RibbonTabItem Header="Home">

                <Fluent:RibbonGroupBox Header="Clipboard">

                    <Fluent:Button Header="Copy" />

                    <Fluent:Button Header="Paste" />

                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Edit">

                    <Fluent:Button Header="Undo" />

                    <Fluent:Button Header="Redo" />

                    <Fluent:Button Header="Delete" />

                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Zoom">

                    <Fluent:Button Header="100%" />

                    <Fluent:Button Header="Fit" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- INSERT -->
            <Fluent:RibbonTabItem Header="Insert">

                <Fluent:RibbonGroupBox Header="Basic">

                    <Fluent:Button Header="Text" />

                    <Fluent:Button Header="Image" />

                    <Fluent:Button Header="Rectangle" />

                    <Fluent:Button Header="Ellipse" />

                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Containers">

                    <Fluent:Button Header="Container" />

                    <Fluent:Button Header="Stack" />

                    <Fluent:Button Header="Grid" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- LAYOUT -->
            <Fluent:RibbonTabItem Header="Layout">

                <Fluent:RibbonGroupBox Header="Align">

                    <Fluent:Button Header="Left" />

                    <Fluent:Button Header="Center" />

                    <Fluent:Button Header="Right" />

                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Arrange">

                    <Fluent:Button Header="Bring Front" />

                    <Fluent:Button Header="Send Back" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- FORMAT -->
            <Fluent:RibbonTabItem Header="Format">

                <Fluent:RibbonGroupBox Header="Appearance">

                    <Fluent:Button Header="Fill" />

                    <Fluent:Button Header="Stroke" />

                    <Fluent:Button Header="Shadow" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- VIEW -->
            <Fluent:RibbonTabItem Header="View">

                <Fluent:RibbonGroupBox Header="Panels">

                    <Fluent:ToggleButton Header="Toolbox" />

                    <Fluent:ToggleButton Header="Layers" />

                    <Fluent:ToggleButton Header="Properties" />

                    <Fluent:ToggleButton Header="Assets" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- AI -->
            <Fluent:RibbonTabItem Header="AI">

                <Fluent:RibbonGroupBox Header="Generate">

                    <Fluent:Button Header="Diagram" />

                    <Fluent:Button Header="Timeline" />

                    <Fluent:Button Header="Mind Map" />

                    <Fluent:Button Header="★ Page" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

        </Fluent:Ribbon>
    </Grid>
</UserControl>
