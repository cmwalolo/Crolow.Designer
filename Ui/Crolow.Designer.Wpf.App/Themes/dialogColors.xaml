<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!--  Base Colors                                               -->
    <!-- ========================================================= -->

    <Color x:Key="DialogBackgroundColor">#FF252526</Color>
    <Color x:Key="DialogSurfaceColor">#FF2D2D30</Color>

    <Color x:Key="DialogForegroundColor">#FFF0F0F0</Color>
    <Color x:Key="DialogSecondaryForegroundColor">#FFB8B8B8</Color>

    <Color x:Key="DialogBorderColor">#FF4C4C4C</Color>

    <Color x:Key="DialogControlBackgroundColor">#FF333337</Color>
    <Color x:Key="DialogControlBorderColor">#FF5A5A5A</Color>

    <Color x:Key="DialogHoverColor">#FF3E3E42</Color>
    <Color x:Key="DialogPressedColor">#FF007ACC</Color>

    <Color x:Key="DialogAccentColor">#FF007ACC</Color>

    <Color x:Key="DialogDisabledBackgroundColor">#FF2A2A2A</Color>
    <Color x:Key="DialogDisabledForegroundColor">#FF777777</Color>

    <!-- ========================================================= -->
    <!--  Brushes                                                   -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="DialogBackgroundBrush"
                     Color="{StaticResource DialogBackgroundColor}" />

    <SolidColorBrush x:Key="DialogSurfaceBrush"
                     Color="{StaticResource DialogSurfaceColor}" />

    <SolidColorBrush x:Key="DialogForegroundBrush"
                     Color="{StaticResource DialogForegroundColor}" />

    <SolidColorBrush x:Key="DialogSecondaryForegroundBrush"
                     Color="{StaticResource DialogSecondaryForegroundColor}" />

    <SolidColorBrush x:Key="DialogBorderBrush"
                     Color="{StaticResource DialogBorderColor}" />

    <SolidColorBrush x:Key="DialogControlBackgroundBrush"
                     Color="{StaticResource DialogControlBackgroundColor}" />

    <SolidColorBrush x:Key="DialogControlBorderBrush"
                     Color="{StaticResource DialogControlBorderColor}" />

    <SolidColorBrush x:Key="DialogHoverBrush"
                     Color="{StaticResource DialogHoverColor}" />

    <SolidColorBrush x:Key="DialogPressedBrush"
                     Color="{StaticResource DialogPressedColor}" />

    <SolidColorBrush x:Key="DialogAccentBrush"
                     Color="{StaticResource DialogAccentColor}" />

    <SolidColorBrush x:Key="DialogDisabledBackgroundBrush"
                     Color="{StaticResource DialogDisabledBackgroundColor}" />

    <SolidColorBrush x:Key="DialogDisabledForegroundBrush"
                     Color="{StaticResource DialogDisabledForegroundColor}" />

</ResourceDictionary>