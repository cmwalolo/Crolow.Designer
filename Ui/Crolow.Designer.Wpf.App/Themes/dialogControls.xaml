<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Label                                                     -->
    <!-- ========================================================= -->

    <Style x:Key="DialogLabel"
           TargetType="{x:Type TextBlock}">

        <Setter Property="Foreground"
                Value="{StaticResource DialogForegroundBrush}" />

        <Setter Property="VerticalAlignment"
                Value="Center" />

        <Setter Property="TextAlignment"
                Value="Right" />

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Margin" Value="0,0,12,0"/>

    </Style>

    <!-- ========================================================= -->
    <!-- TextBox                                                   -->
    <!-- ========================================================= -->
    <Style x:Key="DialogTextBox"
           TargetType="{x:Type TextBox}">

        <Setter Property="Background"
                Value="{StaticResource DialogControlBackgroundBrush}" />

        <Setter Property="Foreground"
                Value="{StaticResource DialogForegroundBrush}" />

        <Setter Property="BorderBrush"
                Value="{StaticResource DialogControlBorderBrush}" />

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="Padding"
                Value="6,4"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Style.Triggers>

            <Trigger Property="IsKeyboardFocused"
                     Value="True">

                <Setter Property="BorderBrush"
                        Value="{StaticResource DialogAccentBrush}" />

            </Trigger>

            <Trigger Property="IsEnabled"
                     Value="False">

                <Setter Property="Background"
                        Value="{StaticResource DialogDisabledBackgroundBrush}" />

                <Setter Property="Foreground"
                        Value="{StaticResource DialogDisabledForegroundBrush}" />

            </Trigger>

        </Style.Triggers>

    </Style>

    <Style x:Key="ValidatedDialogTextBox"
       TargetType="TextBox"
       BasedOn="{StaticResource DialogTextBox}">
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={RelativeSource Self},
                        Path=(Validation.Errors)[0].ErrorContent}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
                <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DialogTextArea"
       TargetType="{x:Type TextBox}"
       BasedOn="{StaticResource DialogTextBox}">

        <Setter Property="VerticalContentAlignment"
            Value="Top"/>

        <Setter Property="AcceptsReturn"
            Value="True"/>

        <Setter Property="TextWrapping"
            Value="Wrap"/>

        <Setter Property="VerticalScrollBarVisibility"
            Value="Auto"/>

        <Setter Property="MinHeight"
            Value="120"/>

    </Style>

    <!-- ========================================================= -->
    <!-- Button                                                    -->
    <!-- ========================================================= -->

    <Style x:Key="DialogButton"
           TargetType="{x:Type Button}">

        <Setter Property="Foreground"
                Value="{StaticResource DialogForegroundBrush}" />

        <Setter Property="Background"
                Value="{StaticResource DialogControlBackgroundBrush}" />

        <Setter Property="BorderBrush"
                Value="{StaticResource DialogControlBorderBrush}" />

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="Padding"
                Value="18,6"/>

        <Setter Property="MinWidth"
                Value="90"/>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="{StaticResource DialogHoverBrush}" />

            </Trigger>

            <Trigger Property="IsPressed"
                     Value="True">

                <Setter Property="Background"
                        Value="{StaticResource DialogPressedBrush}" />

            </Trigger>

            <Trigger Property="IsEnabled"
                     Value="False">

                <Setter Property="Foreground"
                        Value="{StaticResource DialogDisabledForegroundBrush}" />

                <Setter Property="Background"
                        Value="{StaticResource DialogDisabledBackgroundBrush}" />

            </Trigger>

        </Style.Triggers>

    </Style>

    <!-- ========================================================= -->
    <!-- ComboBox                                                  -->
    <!-- ========================================================= -->

    <Style x:Key="DialogComboBox"
           TargetType="{x:Type ComboBox}">

        <Setter Property="Foreground"
                Value="{StaticResource DialogForegroundBrush}" />

        <Setter Property="Background"
                Value="{StaticResource DialogControlBackgroundBrush}" />

        <Setter Property="BorderBrush"
                Value="{StaticResource DialogControlBorderBrush}" />

        <Setter Property="Padding"
                Value="4"/>

    </Style>

    <!-- ========================================================= -->
    <!-- CheckBox                                                  -->
    <!-- ========================================================= -->

    <Style x:Key="DialogCheckBox"
           TargetType="{x:Type CheckBox}">

        <Setter Property="Foreground"
                Value="{StaticResource DialogForegroundBrush}" />

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>

</ResourceDictionary>