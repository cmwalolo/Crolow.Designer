    <UserControl x:Class="Crolow.Designer.Wpf.App.Controls.Tags.TagEditor"
             x:Name="Editor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderBrush="{StaticResource DialogControlBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource DialogControlBackgroundBrush}"
            Padding="6"
            MinHeight="36">

        <Grid>

            <!-- Placeholder -->

            <TextBlock x:Name="Placeholder"
                       Text="Add a tag..."
                       Margin="4,2"
                       Foreground="{StaticResource DialogSecondaryForegroundBrush}"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"/>
            

            <!-- Tags -->

            <WrapPanel x:Name="PART_Panel"
                       VerticalAlignment="Top">

                <ItemsControl ItemsSource="{Binding Tags, ElementName=Editor}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="2"
                                    Padding="8,4"
                                    CornerRadius="12"
                                    Background="{StaticResource DialogHoverBrush}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center"/>

                                    <Button Margin="6,0,0,0"
                                            Padding="0"
                                            Width="16"
                                            Height="16"
                                            FontWeight="Bold"
                                            Content="✕"
                                            Click="RemoveTag_Click"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <TextBox x:Name="PART_Input"
                         Style="{StaticResource DialogTextBox}"
                         MinWidth="120"
                         CaretBrush="White"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Center"
                         KeyDown="Input_KeyDown"
                         TextChanged="Input_TextChanged"/>

            </WrapPanel>

        </Grid>

    </Border>

</UserControl>