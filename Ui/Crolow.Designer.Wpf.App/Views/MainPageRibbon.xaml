<UserControl x:Class="Crolow.Designer.Wpf.App.Views.MainPageRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/runtime"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:Fluent="urn:fluent-ribbon">
    <Grid>
        <Fluent:Ribbon>

            <!-- HOME -->
            <Fluent:RibbonTabItem Header="Home">
                <Fluent:RibbonGroupBox Header="Document">
                    <Fluent:Button Header="New" x:Name="NewDocument" Click="NewDocument_Click" >
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/doc-new.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Open">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/doc-open.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Save">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/doc-save.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Save">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/doc-save-as.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Clipboard">
                    <Fluent:Button Header="Select">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/ui-select-rectangle.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>                    <Fluent:Button Header="Copy">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/object-copy.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Cut">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/object-cut.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Paste">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/object-paste.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Edit">
                    <Fluent:Button Header="Undo">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/object-Undo.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Redo">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/object-redo.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Delete">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/object-delete.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>

                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Zoom">
                    <Fluent:Button Header="100%">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/view-real-size.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>

                    <Fluent:Button Header="Fit">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/view-fit.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Zoom in">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/view-zoom-in.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Zoom out">
                        <Fluent:Button.Icon>
                            <Viewbox Width="16" Height="16">
                                <svgc:SvgViewbox Source="/Resources/Svg/Documents/view-zoom-out.svg" />
                            </Viewbox>
                        </Fluent:Button.Icon>
                    </Fluent:Button>


                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- INSERT -->
            <Fluent:RibbonTabItem Header="Insert">

                <Fluent:RibbonGroupBox Header="Basic">

                    <Fluent:Button Header="Text" />

                    <Fluent:Button Header="Image" />

                    <Fluent:Button Header="Rectangle" />

                    <Fluent:Button Header="Ellipse" />

                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Containers">

                    <Fluent:Button Header="Container" />

                    <Fluent:Button Header="Stack" />

                    <Fluent:Button Header="Grid" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- LAYOUT -->
            <Fluent:RibbonTabItem Header="Layout">

                <Fluent:RibbonGroupBox Header="Align">

                    <Fluent:Button Header="Left" />

                    <Fluent:Button Header="Center" />

                    <Fluent:Button Header="Right" />

                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Arrange">

                    <Fluent:Button Header="Bring Front" />

                    <Fluent:Button Header="Send Back" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- FORMAT -->
            <Fluent:RibbonTabItem Header="Format">

                <Fluent:RibbonGroupBox Header="Appearance">

                    <Fluent:Button Header="Fill" />

                    <Fluent:Button Header="Stroke" />

                    <Fluent:Button Header="Shadow" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- VIEW -->
            <Fluent:RibbonTabItem Header="View">

                <Fluent:RibbonGroupBox Header="Panels">

                    <Fluent:ToggleButton Header="Toolbox" />

                    <Fluent:ToggleButton Header="Layers" />

                    <Fluent:ToggleButton Header="Properties" />

                    <Fluent:ToggleButton Header="Assets" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

            <!-- AI -->
            <Fluent:RibbonTabItem Header="AI">

                <Fluent:RibbonGroupBox Header="Generate">

                    <Fluent:Button Header="Diagram" />

                    <Fluent:Button Header="Timeline" />

                    <Fluent:Button Header="Mind Map" />

                    <Fluent:Button Header="★ Page" />

                </Fluent:RibbonGroupBox>

            </Fluent:RibbonTabItem>

        </Fluent:Ribbon>
    </Grid>
</UserControl>
