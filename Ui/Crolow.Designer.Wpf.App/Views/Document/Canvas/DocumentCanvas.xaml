<UserControl
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:Crolow.Designer.Wpf.App.Views.Document"
            xmlns:editors="clr-namespace:Crolow.Designer.Wpf.App.Views.Document.Canvas.SelectionEditors"
            xmlns:Fluent="urn:fluent-ribbon" 
            x:Class="Crolow.Designer.Wpf.App.Views.Document.Canvas.DocumentCanvas"
            xmlns:svgc="http://sharpvectors.codeplex.com/svgc/" 
            xmlns:svg="http://sharpvectors.codeplex.com/runtime"
            xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
            xmlns:listview="clr-namespace:Crolow.Designer.Wpf.App.Controls.Listview"
            xmlns:enum ="clr-namespace:Crolow.Designer.UI.Enumerations;assembly=Crolow.Designer.UI"
            mc:Ignorable="d" 
            d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
            <Fluent:RibbonGroupBox x:Name="toolboxContainer" Width="43"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="4">
                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.SelectRectangle}"  Click="ToggleButton_Click"  GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/ui-select-2.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>

                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.Crop}" GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/ui-crop.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>
                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.Rectangle}" GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/shape-rectangle.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>

                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.Circle}" GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/shape-circle.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>

                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.Path}" GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/shape-path.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>

                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.Polygon}" GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/shape-polygon.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>

                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.Text}" GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/shape-text.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>
                <Fluent:ToggleButton Tag="{x:Static enum:ToolboxTool.DocumentRef}" GroupName="ToolboxTools" Padding="0" Margin="0" Width="34" Height="34">
                    <Fluent:ToggleButton.Icon>
                        <Viewbox Width="12" Height="12">
                            <svgc:SvgViewbox Source="/Resources/Svg/Documents/ui-document-ref.svg" />
                        </Viewbox>
                    </Fluent:ToggleButton.Icon>
                </Fluent:ToggleButton>
            </Fluent:RibbonGroupBox>
        </Border>

        <Border Grid.Column="1" x:Name="CanvasBorder" Background="Transparent">
            <Grid>
                <skia:SKElement x:Name="SkCanvas"
                                PaintSurface="OnCanvasPaintSurface"
                        IgnorePixelScaling="True"/>

                <skia:SKElement x:Name="SkOverlay"
                        PaintSurface="OnOverlayPaintSurface"
                        MouseMove="OnOverlayMouseMove"
                        MouseDown="OnOverlayMouseDown"
                        MouseUp="OnOverlayMouseUp"
                        IgnorePixelScaling="True"/>
                <UserControl x:Name="editorContainer">
                    <editors:SelectionTransformController IsChanged="SelectionController_IsChanged" IsChanging="SelectionController_IsChanging"     Visibility="Hidden" x:Name="SelectionController"/>
                </UserControl>
            </Grid>
        </Border>   
    </Grid>
</UserControl>
