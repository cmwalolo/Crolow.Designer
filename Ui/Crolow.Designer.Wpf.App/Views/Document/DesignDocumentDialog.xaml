<Window x:Class="Crolow.Designer.Wpf.App.Views.Document.DesignDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Properties"
        Width="700"
        Height="500"
        MinWidth="700"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Border Padding="20"
            Background="{DynamicResource DialogBackgroundBrush}">

        <DockPanel>

            <!-- Buttons -->

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Width="90"
                        Margin="5,0,0,0"
                        Content="OK"
                        Command="{Binding OkCommand}" />

                <Button Width="90"
                        Margin="5,0,0,0"
                        IsCancel="True"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"/>

            </StackPanel>

            <!-- Form -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Name -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Name"
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,0,12"
                         Text="{Binding Name}" />

                <!-- Description -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Description"
                           VerticalAlignment="Top"
                           Margin="0,0,10,12"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Height="100"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12"
                         Text="{Binding Description}" />

                <!-- File -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="File"
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,0,0,12"
                         Text="{Binding FilePath}" />

                <!-- Canvas -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Canvas"
                           VerticalAlignment="Center"
                           Margin="0,0,10,20"/>

                <Grid Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Width}" />

                    <TextBlock Grid.Column="1"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               Text="×"/>

                    <TextBox Grid.Column="2"
                             Text="{Binding Height}" />

                    <TextBlock Grid.Column="3"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               Text="px"/>

                </Grid>

                <!-- Tags -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Tags"
                           VerticalAlignment="Top"
                           Margin="0,0,10,0"/>

                <Border Grid.Row="4"
                        Grid.Column="1"
                        BorderBrush="#666"
                        BorderThickness="1">

                    <!-- Future TagEditor -->
                    <Grid Height="100"/>

                </Border>

            </Grid>

        </DockPanel>

    </Border>

</Window>