<UserControl
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:Crolow.Designer.Wpf.App.Views.Document"
            xmlns:Fluent="urn:fluent-ribbon" 
            x:Class="Crolow.Designer.Wpf.App.Views.Document.DocumentCanvas"
            xmlns:svgc="http://sharpvectors.codeplex.com/svgc/" 
            xmlns:listview="clr-namespace:Crolow.Designer.Wpf.App.Controls.Listview"
            mc:Ignorable="d" 
            d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                    Margin="4,2">

                <Button Width="28"
                    Height="28"
                    ToolTip="Edit"
                    Click="EditDocument_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand">

                    <Viewbox Width="16" Height="16">
                        <svgc:SvgViewbox Source="/Resources/Svg/Documents/object-edit.svg"/>
                    </Viewbox>

                </Button>
            </StackPanel>
        </Border>
        <listview:DocumentTree Grid.Row="1" x:Name="DocumentTree"/>
    </Grid>
</UserControl>
